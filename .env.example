# ==========================================
# RESTAURANT OS — ENVIRONMENT CONFIGURATION (TEMPLATE)
# ==========================================

# AI Providers & Automatic Fallback System
AI_PRIMARY_PROVIDER=google-ai
AI_FALLBACK_PROVIDER=openrouter
AI_ENABLE_AUTO_FALLBACK=true

GOOGLE_AI_API_KEY=your_google_ai_key_here
OPENROUTER_API_KEY=your_openrouter_key_here

# AI Models Setup
AI_MODEL_FAST=gemini-3.5-flash-lite
AI_MODEL_SMART=gemini-3.5-flash
AI_MODEL_LITE=gemini-3.1-flash-lite
AI_MODEL_HEAVY=google/gemma-4-31b-it

# Cloudinary Storage
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_FOLDER=restaurant_os

# Firebase Config
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_DATABASE_URL=https://your_project.firebasedatabase.app
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# Cloudflare Tunnel
CLOUDFLARE_TUNNEL_TOKEN=your_cloudflare_tunnel_token

# Web Push Notifications
VITE_WEB_PUSH_PUBLIC_KEY=your_web_push_vapid_public_key

# Weather API
VITE_WEATHER_PROVIDER=open-meteo
VITE_OPENWEATHER_API_KEY=your_openweather_api_key

# General Config
PORT=3000
NODE_ENV=development
APP_NAME="Restaurant OS"
DEFAULT_LOCALE=auto
DEFAULT_CURRENCY=auto

# Windows code signing (build machine only — never commit the .pfx file).
# When set, electron-builder signs the installer automatically (CSC_* is
# picked up with no config change). Without it, builds stay unsigned and
# Windows SmartScreen warns on first run — fine for internal testing.
# CSC_LINK=C:\certs\restaurant-os.pfx
# CSC_KEY_PASSWORD=your_cert_password_here
